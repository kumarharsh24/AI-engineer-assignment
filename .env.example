# =====================================================================
# Hasamex AI Engineer Platform - Environment Configuration
# =====================================================================
# NOTE: All variables in this file are OPTIONAL!
# The app works 100% out-of-the-box in "Offline Verified Mode" without any API keys.
#
# To use an LLM for enhanced Q&A answers, copy this file to `.env` and insert your key:
# cp .env.example .env
# =====================================================================

# (Optional) OpenAI API key for LLM-Augmented Q&A synthesis
# Format: sk-proj-... or sk-...
OPENAI_API_KEY=

# (Optional) Default OpenAI model choice: gpt-4o-mini or gpt-4o
OPENAI_MODEL=gpt-4o-mini

# (Optional) Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false
